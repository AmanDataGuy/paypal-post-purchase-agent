# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox). Sandbox only: the app refuses live URLs.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section (URL: https://<your-host>/api/webhooks/paypal). Optional locally.
PAYPAL_WEBHOOK_ID=

# Models for the chat assistant, tried in order: provider:model, providers gemini | groq | ollama.
# Set this OR ANTHROPIC_API_KEY. MCP and the console work without either.
LLM_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite
GEMINI_API_KEY=
GROQ_API_KEY=
# Simulated customer in `npm run eval` when LLM_CHAIN is set.
EVAL_SIM_CHAIN=gemini:gemini-3.5-flash-lite

# Claude (console.anthropic.com), used when LLM_CHAIN is empty.
ANTHROPIC_API_KEY=
# Cheaper model for testing: claude-haiku-5-5 or claude-sonnet-5-5. Unset = claude-opus-5-5 (use for the demo video).
AGENT_MODEL=claude-haiku-5-5

# Passcode for /console (approvals, PayPal cases). Pick any long string; give it to judges in the README.
CONSOLE_PASSCODE=

# Postgres URL in production. Leave empty locally to use the embedded database in ./.data
DATABASE_URL=
